{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "yarn",
    "schematicCollections": ["@ionic/angular-toolkit"]
  },
  "newProjectRoot": "apps",
  "projects": {
    "admin-pwa": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": { "style": "scss", "skipTests": true },
        "@schematics/angular:directive": { "skipTests": true },
        "@schematics/angular:interceptor": { "skipTests": true },
        "@schematics/angular:service": { "skipTests": true, "type": "service" },
        "@schematics/angular:guard": { "skipTests": true },
        "@ionic/angular-toolkit:page": {
          "standalone": true,
          "skipTests": true
        },
        "@ionic/angular-toolkit:component": {
          "standalone": true,
          "skipTests": true
        },
        "@ionic/angular-toolkit:service": {
          "standalone": true,
          "skipTests": true
        },
        "@ionic/angular-toolkit:pipe": { "skipTests": true },
        "@ionic/angular-toolkit:interceptor": { "skipTests": true },
        "@ionic/angular-toolkit:guard": { "skipTests": true }
      },
      "root": "apps/admin-pwa",
      "sourceRoot": "apps/admin-pwa/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/admin-pwa/src/main.ts",
            "tsConfig": "apps/admin-pwa/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "apps/admin-pwa/src/styles.scss",
              { "input": "node_modules/@ionic/angular/css/core.css" },
              { "input": "node_modules/@ionic/angular/css/normalize.css" },
              { "input": "node_modules/@ionic/angular/css/structure.css" },
              { "input": "node_modules/@ionic/angular/css/typography.css" },
              { "input": "node_modules/@ionic/angular/css/display.css" },
              { "input": "node_modules/@ionic/angular/css/padding.css" },
              { "input": "node_modules/@ionic/angular/css/float-elements.css" },
              { "input": "node_modules/@ionic/angular/css/text-alignment.css" },
              {
                "input": "node_modules/@ionic/angular/css/text-transformation.css"
              },
              { "input": "node_modules/@ionic/angular/css/flex-utils.css" },
              { "input": "apps/admin-pwa/src/theme/variables.css" }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],

              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "admin-pwa:build:production" },
            "development": { "buildTarget": "admin-pwa:build:development" }
          },
          "defaultConfiguration": "development",
          "options": { "port": 3930 }
        },
        "test": { "builder": "@angular/build:unit-test" }
      }
    },
    "worker-pwa": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": { "style": "scss" },
        "@schematics/angular:directive": { "skipTests": true },
        "@schematics/angular:interceptor": { "skipTests": true },
        "@schematics/angular:service": { "skipTests": true, "type": "service" },
        "@schematics/angular:guard": { "skipTests": true },
        "@ionic/angular-toolkit:page": {
          "standalone": true,
          "skipTests": true
        },
        "@ionic/angular-toolkit:component": {
          "standalone": true,
          "skipTests": true
        },
        "@ionic/angular-toolkit:service": {
          "standalone": true,
          "skipTests": true
        },
        "@ionic/angular-toolkit:pipe": { "skipTests": true },
        "@ionic/angular-toolkit:interceptor": { "skipTests": true },
        "@ionic/angular-toolkit:guard": { "skipTests": true }
      },
      "root": "apps/worker-pwa",
      "sourceRoot": "apps/worker-pwa/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/worker-pwa/src/main.ts",
            "tsConfig": "apps/worker-pwa/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "apps/worker-pwa/src/styles.scss",
              { "input": "node_modules/@ionic/angular/css/core.css" },
              { "input": "node_modules/@ionic/angular/css/normalize.css" },
              { "input": "node_modules/@ionic/angular/css/structure.css" },
              { "input": "node_modules/@ionic/angular/css/typography.css" },
              { "input": "node_modules/@ionic/angular/css/display.css" },
              { "input": "node_modules/@ionic/angular/css/padding.css" },
              { "input": "node_modules/@ionic/angular/css/float-elements.css" },
              { "input": "node_modules/@ionic/angular/css/text-alignment.css" },
              {
                "input": "node_modules/@ionic/angular/css/text-transformation.css"
              },
              { "input": "node_modules/@ionic/angular/css/flex-utils.css" },
              { "input": "apps/worker-pwa/src/theme/variables.css" }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "worker-pwa:build:production" },
            "development": { "buildTarget": "worker-pwa:build:development" }
          },
          "defaultConfiguration": "development",
          "options": { "port": 3900 }
        },
        "test": { "builder": "@angular/build:unit-test" }
      }
    }
  },
  "schematics": {
    "@ionic/angular-toolkit:component": { "styleext": "scss" },
    "@ionic/angular-toolkit:page": { "styleext": "scss" }
  }
}
